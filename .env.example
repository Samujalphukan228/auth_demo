# Database
DATABASE_URL=mysql://root:password@localhost/auth_demo

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_min_32_chars

# Brevo Email API
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Your App Name

# Server
PORT=8080
APP_URL=http://localhost:8080

# CORS — frontend URL
ALLOWED_ORIGIN=http://localhost:3000

# set to true in production (HTTPS)
COOKIE_SECURE=false